# =============================================================================
# Local development (copy to backend/.env)
# =============================================================================

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/taskflow

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=your_64_char_hex_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated (Docker-friendly) or JSON array
CORS_ORIGINS=http://localhost:5173
DEBUG=false

# Tests (Codespace/devcontainer uses @db; local host uses @localhost)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/taskflow_test

# =============================================================================
# Self-host stack — see docker/.env.example and docker/docker-compose.yaml
# =============================================================================
